rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isVip() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/vips/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/vips/$(request.auth.uid)).data.until > request.time;
    }
    match /apps/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']));
      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid &&
          request.resource.data.v is int &&
          request.resource.data.v >= 1 && request.resource.data.v <= 5;
      }
    }
    // link & key aplikasi VIP: hanya member VIP aktif atau admin
    match /vipLinks/{id} {
      allow read: if isVip() || isAdmin();
      allow write: if isAdmin();
    }
    // status VIP: user hanya bisa baca miliknya; yang menulis hanya server (api/vip.js)
    match /vips/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }
    match /vipKeys/{k} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /reports/{rid} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
